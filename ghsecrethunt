#!/usr/bin/env python3
"""
ghsecrethunt - Find secrets that were EVER committed to docs/ (or any
path you choose) in a repo's full git history, across all branches, tags, and
pull-request refs.

Why history matters: deleting a secret from a file does not remove it from git.
Anyone who cloned, forked, or browsed an old commit can still recover it. This
script finds those secrets and builds an exposure timeline for each one.

For each repo it:
  1. Reuses the mirror from ghworkflowhunt (evidence/<owner>__<repo>/mirror.git)
     if present; otherwise mirror-clones it there (gc disabled).
  2. Walks every commit that touched the target paths and scans added (+) and
     removed (-) lines against a set of secret rules.
  3. Checks whether each secret is still present at the tip of the default branch.
  4. Writes:
       docs_secret_findings.tsv  - one row per occurrence (commit, file, line)
       docs_secret_summary.tsv   - one row per unique secret with first-added /
                                   last-removed dates and current status
     Secrets are REDACTED in output (first/last 4 chars) with a SHA-256 of the
     full value, so you can match against the client's inventory without
     spreading plaintext. Use --unredacted to also write the raw values.

Usage:
  python3 ghsecrethunt.py owner/repo1 owner/repo2
  python3 ghsecrethunt.py owner/repo --path docs --path site --path README.md
  python3 ghsecrethunt.py owner/repo --all-paths       # whole repo
  python3 ghsecrethunt.py /path/to/local/repo.git      # a local clone/mirror

  To check a known secret against findings:  echo -n 'THE_SECRET' | sha256sum

At the end it prints a formatted report (an overview table when you scan more
than one repo, then each repo's secrets, high severity and still-present first)
and saves it to <out>/secret_hunt.txt (latest) and secret_hunt_<timestamp>.txt.
All times are UTC.

Tables are tab-separated (.tsv). Color is used only when stderr is a terminal;
set NO_COLOR=1 or pass --no-color to turn it off.

Requires: Python 3.8+, git on PATH. No third-party packages. No token needed for
public repos (this script only uses git, not the API).
"""
import argparse
import base64
import hashlib
import json
import math
import os
import re
import subprocess
import sys
from collections import Counter, defaultdict
from datetime import datetime, timezone
from pathlib import Path

