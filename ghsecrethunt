# --------------------------------------------------------------------------- output


def _color_enabled(stream):
    if os.environ.get("NO_COLOR"):
        return False
    if os.environ.get("FORCE_COLOR"):
        return True
    return hasattr(stream, "isatty") and stream.isatty() and os.environ.get("TERM") != "dumb"


USE_COLOR = _color_enabled(sys.stderr)
USE_COLOR_OUT = _color_enabled(sys.stdout)
_STYLES = {"info": "", "ok": "32", "warn": "33", "error": "1;31",
           "flag": "1;35", "head": "1;36", "dim": "2", "bold": "1"}


def paint(text, style, enabled=None):
    code = _STYLES.get(style, style)
    on = USE_COLOR if enabled is None else enabled
    return f"\033[{code}m{text}\033[0m" if on and code else text


def utc(iso):
    """ISO-8601 with any offset -> 'YYYY-MM-DD HH:MM:SS' UTC."""
    if not iso:
        return ""
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone(timezone.utc).strftime("%Y-%m-%d %H:%M:%S")
    except ValueError:
        return iso


def _fit(text, width):
    text = "" if text is None else str(text)
    return text if len(text) <= width else text[:max(1, width - 1)] + "…"


def table(headers, rows, widths, color, indent="  "):
    def cell(v, w):
        txt, style = v if isinstance(v, tuple) else (v, "")
        txt = _fit(txt, w).ljust(w)
        return paint(txt, style, color) if style else txt
    out = [paint((indent + "  ".join(_fit(h, w).ljust(w) for h, w in zip(headers, widths))).rstrip(), "head", color),
           indent + "  ".join("─" * w for w in widths)]
    for r in rows:
        out.append(indent + "  ".join(cell(v, w) for v, w in zip(r, widths)).rstrip())
    return out


def log(msg, level="info"):
    ts = paint(datetime.now().strftime("%H:%M:%S"), "dim")
    print(f"[{ts}] {paint(msg, level)}", file=sys.stderr)


def die(msg):
    log(msg, "error")
    sys.exit(1)


_REPO_RE = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]{1,100}$")


def normalize_repos(args, allow_paths=False):
    """Accept repos as separate args, one quoted space/comma-separated string (zsh
    doesn't split $VAR), or GitHub URLs. Returns a de-duplicated, validated list."""
    out, bad = [], []
    for arg in args:
        for item in re.split(r"[\s,]+", arg.strip()):
            if not item:
                continue
            if allow_paths and Path(item).exists():
                out.append(item)
                continue
            item = re.sub(r"^(?:https?://|git@)?(?:www\.)?github\.com[/:]", "", item)
            item = re.sub(r"(?:\.git)?/?$", "", item)
            (out if _REPO_RE.match(item) else bad).append(item)
    if bad:
        die("Not a valid owner/repo: " + ", ".join(bad))
    return list(dict.fromkeys(out))


def write_tsv(path, rows, fields=None):
    """Tab-separated output; tabs/newlines inside values become spaces."""
    fields = fields or (list(rows[0].keys()) if rows else [])

    def clean(v):
        return re.sub(r"[\t\r\n]+", " ", "" if v is None else str(v))

    with path.open("w", encoding="utf-8", newline="") as f:
        f.write("\t".join(fields) + "\n")
        for r in rows:
            f.write("\t".join(clean(r.get(k, "")) for k in fields) + "\n")


def entropy(s):
    if not s:
        return 0.0
    c = Counter(s)
    return -sum(v / len(s) * math.log2(v / len(s)) for v in c.values())


def redact(s):
    return s if len(s) <= 10 else f"{s[:4]}...{s[-4:]} (len {len(s)})"


def find_secrets(line):
    out = []
    for name, sev, rx in COMPILED:
        for m in rx.finditer(line):
            val = m.group(1) if m.groups() else m.group(0)
            if sev == "generic":
                if PLACEHOLDER.match(val) or entropy(val) < 3.0:
                    continue
                if not (re.search(r"\d", val) and re.search(r"[A-Za-z]", val)):
                    continue  # skip plain words like 'password: required'
            elif PLACEHOLDER.match(val) and name != "private_key":
                continue
            out.append((name, sev, val))
    # Drop generic hits that duplicate a specific rule's value on the same line
    specific = {v for n, s, v in out if s != "generic"}
    return [(n, s, v) for n, s, v in out if not (s == "generic" and any(v in x or x in v for x in specific))]


# --------------------------------------------------------------------------- git


# Authenticated git access for private repos. The token is handed to git through
# environment-scoped config (GIT_CONFIG_COUNT, git >= 2.31), so it never appears in
# a process listing, in the mirror's .git/config, or in any evidence file.
GIT_AUTH_ENV = {}


def set_git_auth(token):
    global GIT_AUTH_ENV
    GIT_AUTH_ENV = {}
    if not token:
        return "anonymous (public repos only)"
    m = re.search(r"(\d+)\.(\d+)", subprocess.run(["git", "--version"], capture_output=True, text=True).stdout)
    if not m or (int(m.group(1)), int(m.group(2))) < (2, 31):
        log("git older than 2.31: cloning without the token, so private repos will be skipped", "warn")
        return "anonymous (git too old for safe token passing)"
    basic = base64.b64encode(f"x-access-token:{token}".encode()).decode()
    GIT_AUTH_ENV = {"GIT_CONFIG_COUNT": "1",
                    "GIT_CONFIG_KEY_0": "http.https://github.com/.extraheader",
                    "GIT_CONFIG_VALUE_0": f"AUTHORIZATION: basic {basic}"}
    return "with token (private repos the token can read)"


def clone_error(stderr):
    """Short, useful reason from a failed clone/fetch."""
    last = (stderr or "").strip().splitlines()[-1:] or [""]
    reason = last[0].replace("fatal: ", "")
    low = (stderr or "").lower()
    if "could not read username" in low or "repository not found" in low or "not found" in reason.lower():
        return ("not found, or not readable with this token (no access to the repo, token expired/"
                "revoked, or not SSO-authorized; check with ./ghtokenusage)" if GIT_AUTH_ENV
                else "repository not found, or private (no token: public repos only)")
    if "authentication failed" in low or "invalid username or token" in low or "401" in low:
        return "token rejected by git (expired, revoked, or not authorized for this org's SSO)"
    if "403" in low:
        return "access denied (403): token lacks Contents: read on this repo, or SSO authorization"
    return reason[:200]


def git(args, cwd=None, check=True):
    # Never prompt for credentials (a missing/private repo would otherwise hang)
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0", **GIT_AUTH_ENV}
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True,
                       text=True, errors="replace", env=env)
    if check and r.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)} failed: {r.stderr.strip()}")
    return r


def get_mirror(target, evidence: Path):
    p = Path(target)
    if p.exists() and ((p / "HEAD").exists() or (p / ".git").exists()):
        return p, p.name
    repo_dir = evidence / target.replace("/", "__")
    mirror = repo_dir / "mirror.git"
    repo_dir.mkdir(parents=True, exist_ok=True)
    if mirror.exists():
        log(f"  reusing mirror {mirror} (fetching new refs, no prune)")
        git(["fetch", "origin", "+refs/*:refs/*"], cwd=mirror, check=False)
    else:
        log(f"  mirror cloning {target}")
        git(["clone", "--mirror", f"https://github.com/{target}.git", str(mirror)])
    git(["config", "gc.auto", "0"], cwd=mirror)
    git(["config", "gc.pruneExpire", "never"], cwd=mirror)
    return mirror, target


def head_snapshot(mirror, paths):
    """Concatenated text of target paths at the default branch tip."""
    if git(["rev-parse", "--verify", "HEAD"], cwd=mirror, check=False).returncode != 0:
        return "", "(none)"
    branch = git(["symbolic-ref", "--short", "HEAD"], cwd=mirror, check=False).stdout.strip() or "HEAD"
    files = git(["ls-tree", "-r", "--name-only", "HEAD", "--", *paths], cwd=mirror).stdout.splitlines()
    chunks = []
    for f in files:
        r = git(["cat-file", "-p", f"HEAD:{f}"], cwd=mirror, check=False)
        if r.returncode == 0 and "\x00" not in r.stdout[:8000]:
            chunks.append(r.stdout)
    return "\n".join(chunks), branch


COMMIT_FMT = "%x1eC%x1f%H%x1f%an%x1f%ae%x1f%aI%x1f%cn%x1f%ce%x1f%cI%x1f%s"


def scan_history(mirror, paths):
    """Yield (commit_meta, file, sign, line_no, line_text) for every +/- line."""
    cmd = ["log", "--all", "-p", "--no-color", "--no-renames", "--no-ext-diff",
           "-U0", f"--format={COMMIT_FMT}"]
    if paths:
        cmd += ["--", *paths]
    proc = subprocess.Popen(["git", *cmd], cwd=mirror, stdout=subprocess.PIPE,
                            text=True, errors="replace")
    meta, cur_file, in_hunk, old_no, new_no = None, None, False, 0, 0
    for raw in proc.stdout:
        line = raw.rstrip("\n")
        if line.startswith("\x1eC\x1f"):
            f = line.split("\x1f")
            meta = {"commit": f[1], "author": f"{f[2]} <{f[3]}>", "author_date": f[4],
                    "committer": f"{f[5]} <{f[6]}>", "committer_date": f[7], "subject": f[8]}
            cur_file, in_hunk = None, False
        elif line.startswith("diff --git "):
            m = re.match(r"diff --git a/(.+?) b/(.+)$", line)
            cur_file, in_hunk = (m.group(2) if m else line), False
        elif line.startswith("@@"):
            m = re.match(r"@@ -(\d+)(?:,\d+)? \+(\d+)", line)
            if m:
                old_no, new_no, in_hunk = int(m.group(1)), int(m.group(2)), True
        elif in_hunk and meta and cur_file:
            if line.startswith("+"):
                yield meta, cur_file, "+", new_no, line[1:]
                new_no += 1
            elif line.startswith("-"):
                yield meta, cur_file, "-", old_no, line[1:]
                old_no += 1
    proc.wait()


def refs_containing(mirror, sha, cache):
    if sha not in cache:
        cache[sha] = git(["for-each-ref", "--contains", sha, "--format=%(refname)"],
                         cwd=mirror, check=False).stdout.split()
    return cache[sha]


# --------------------------------------------------------------------------- main

def hunt(target, evidence, paths, unredacted):
    mirror, label = get_mirror(target, evidence)
    out_dir = evidence / label.replace("/", "__") if not Path(target).exists() else evidence / f"local__{label}"
    out_dir.mkdir(parents=True, exist_ok=True)
    log(f"  scanning history of {paths or ['(entire repo)']}")

    snapshot, branch = head_snapshot(mirror, paths)
    findings, seen, ref_cache = [], set(), {}
    for meta, path, sign, ln, text in scan_history(mirror, paths):
        for rule, sev, val in find_secrets(text):
            h = hashlib.sha256(val.encode()).hexdigest()
            key = (meta["commit"], path, sign, h)
            if key in seen:
                continue
            seen.add(key)
            findings.append({
                "secret_sha256": h, "rule": rule, "severity": sev,
                "redacted": redact(val), "change": "added" if sign == "+" else "removed",
                "file": path, "line": ln, "committed_utc": utc(meta["committer_date"]), **meta,
                "in_refs": ";".join(refs_containing(mirror, meta["commit"], ref_cache))[:2000],
                "_value": val,
            })

    findings.sort(key=lambda r: (r["committed_utc"], r["change"] != "added"))
    fields = [k for k in (findings[0].keys() if findings else []) if k != "_value"]
    write_tsv(out_dir / "docs_secret_findings.tsv", findings, fields or ["secret_sha256"])

    # One row per unique secret: exposure timeline
    by_secret = defaultdict(list)
    for r in findings:
        by_secret[r["secret_sha256"]].append(r)
    summary = []
    for h, rows in by_secret.items():
        adds = [r for r in rows if r["change"] == "added"]
        rems = [r for r in rows if r["change"] == "removed"]
        val = rows[0]["_value"]
        first = min(adds or rows, key=lambda r: r["committed_utc"])
        last_rm = max(rems, key=lambda r: r["committed_utc"]) if rems else None
        summary.append({
            "secret_sha256": h, "rule": rows[0]["rule"], "severity": rows[0]["severity"],
            "redacted": rows[0]["redacted"],
            "present_at_head": "YES" if val in snapshot else "no",
            "first_added_utc": first["committed_utc"], "first_added_commit": first["commit"],
            "first_added_by": first["author"], "first_file": first["file"],
            "last_removed_utc": last_rm["committed_utc"] if last_rm else "",
            "last_removed_commit": last_rm["commit"] if last_rm else "",
            "files": ";".join(sorted({r["file"] for r in rows})),
            "occurrences": len(rows),
        })
    sev_rank = {"high": 0, "medium": 1, "generic": 2}
    summary.sort(key=lambda r: (sev_rank.get(r["severity"], 9), r["present_at_head"] != "YES", r["first_added_utc"]))
    write_tsv(out_dir / "docs_secret_summary.tsv", summary, None if summary else ["secret_sha256"])

    if unredacted and findings:
        raw = {h: rows[0]["_value"] for h, rows in by_secret.items()}
        p = out_dir / "docs_secrets_UNREDACTED.json"
        p.write_text(json.dumps(raw, indent=2))
        log(f"  WARNING: plaintext secrets written to {p}; handle as sensitive", "warn")

    stats = {
        "default_branch": branch, "paths": paths or ["(entire repo)"],
        "unique_secrets": len(summary),
        "high": sum(1 for s in summary if s["severity"] == "high"),
        "medium": sum(1 for s in summary if s["severity"] == "medium"),
        "generic": sum(1 for s in summary if s["severity"] == "generic"),
        "still_present_at_head": sum(1 for s in summary if s["present_at_head"] == "YES"),
        "output_dir": str(out_dir),
    }
    log(f"  {stats['unique_secrets']} unique secret(s): {stats['high']} high, {stats['medium']} medium, "
        f"{stats['generic']} generic; {stats['still_present_at_head']} still at HEAD",
        "flag" if stats["high"] or stats["medium"] else "ok")
    return stats, summary


SEV_STYLE = {"high": "error", "medium": "warn", "generic": "dim"}


def load_previous(target, evidence):
    """Rebuild a repo's results from docs_secret_summary.tsv written by an earlier run (any version)."""
    p = Path(target)
    out_dir = evidence / (f"local__{p.name}" if p.exists() else target.replace("/", "__"))
    tsv = out_dir / "docs_secret_summary.tsv"
    if not tsv.exists():
        raise RuntimeError(f"no earlier results ({tsv} not found)")
    lines = tsv.read_text(encoding="utf-8", errors="replace").splitlines()
    head = lines[0].split("\t") if lines else []
    summary = []
    for ln in lines[1:]:
        if not ln:
            continue
        r = dict(zip(head, ln.split("\t")))
        r.setdefault("first_added_utc", utc(r.get("first_added_date", "")))   # files from v1.1.x
        r.setdefault("last_removed_utc", utc(r.get("last_removed_date", "")))
        if r.get("secret_sha256"):
            summary.append(r)
    mirror = p if p.exists() else out_dir / "mirror.git"
    branch = git(["symbolic-ref", "--short", "HEAD"], cwd=mirror, check=False).stdout.strip() if mirror.exists() else "?"
    stats = {"default_branch": branch or "?", "unique_secrets": len(summary),
             "high": sum(1 for x in summary if x["severity"] == "high"),
             "medium": sum(1 for x in summary if x["severity"] == "medium"),
             "generic": sum(1 for x in summary if x["severity"] == "generic"),
             "still_present_at_head": sum(1 for x in summary if x.get("present_at_head") == "YES"),
             "output_dir": str(out_dir)}
    sev_rank = {"high": 0, "medium": 1, "generic": 2}
    summary.sort(key=lambda r: (sev_rank.get(r["severity"], 9), r.get("present_at_head") != "YES", r["first_added_utc"]))
    return stats, summary


def render(meta, results, color, generic_limit):
    W = 78
    L = []
    rule = paint("═" * W, "head", color)
    L += [rule, paint(" Secrets in git history — summary".ljust(W - 25) + f"ghsecrethunt {__version__}",
                      "head", color), rule]

    def kv(k, v, style=""):
        L.append(f"  {k:<26}{paint(str(v), style, color) if style else v}")

    ok = {r: d for r, d in results.items() if "error" not in d}
    hit = [r for r, d in ok.items() if d["stats"]["unique_secrets"]]
    kv("Collected (UTC)", meta["collected"])
    kv("Scope", ", ".join(meta["paths"]) if meta["paths"] else "entire repo, all history, all refs")
    kv("Rules", f"{meta['rules']} ({meta['rules_high']} high-confidence + generic)")
    kv("Repos scanned", f"{len(results)}  ({len(hit)} with findings, {len(ok) - len(hit)} clean"
       + (f", {len(results) - len(ok)} failed)" if len(results) > len(ok) else ")"),
       "flag" if hit else "ok")
    for r, d in results.items():
        if "error" in d:
            kv("FAILED", f"{r}: {d['error'][:120]}", "error")
    totals = {k: sum(d["stats"][k] for d in ok.values()) for k in ("high", "medium", "generic", "still_present_at_head")}
    kv("Secrets found", f"{totals['high']} high, {totals['medium']} medium, {totals['generic']} generic",
       "flag" if totals["high"] else "")
    kv("Still at HEAD", totals["still_present_at_head"], "error" if totals["still_present_at_head"] else "ok")

    order = sorted(ok, key=lambda r: (-ok[r]["stats"]["high"], -ok[r]["stats"]["still_present_at_head"],
                                      -ok[r]["stats"]["medium"], -ok[r]["stats"]["generic"], r))
    if len(results) > 1:
        L += ["", paint("  All repos at a glance (most serious first)", "head", color)]

        def n(v, style):
            return (str(v), style) if v else ("0", "dim")
        rows = []
        for r in order:
            st, sm = ok[r]["stats"], ok[r]["summary"]
            oldest = min((x["first_added_utc"] for x in sm if x["severity"] != "generic"), default="")
            rows.append([(r, "flag") if st["high"] else r, n(st["high"], "error"), n(st["medium"], "warn"),
                         n(st["generic"], "dim"), n(st["still_present_at_head"], "error"), oldest[:10] or "—"])
        L += table(["Repo", "High", "Medium", "Generic", "At HEAD", "Oldest high/med"], rows,
                   [34, 6, 7, 8, 8, 15], color)
        L.append(paint("  At HEAD = still in the current default branch (not just history). Details follow, in this order.",
                       "dim", color))

    for r in order:
        st, sm = ok[r]["stats"], ok[r]["summary"]
        L += ["", paint(f"── {r} " + "─" * max(3, W - len(r) - 4), "head", color)]
        kv("Default branch", st["default_branch"])
        kv("Unique secrets", f"{st['unique_secrets']}  ({st['high']} high, {st['medium']} medium, {st['generic']} generic)",
           "flag" if st["high"] else ("ok" if not st["unique_secrets"] else ""))
        kv("Still at HEAD", st["still_present_at_head"], "error" if st["still_present_at_head"] else "ok")
        if not sm:
            continue
        shown = [x for x in sm if x["severity"] != "generic"]
        gen = [x for x in sm if x["severity"] == "generic"]
        shown += gen[:generic_limit]
        L += [""]
        L += table(["Sev", "Rule", "Redacted value", "HEAD", "First added (UTC)", "By", "Removed (UTC)", "File"],
                   [[(x["severity"], SEV_STYLE.get(x["severity"], "")), x["rule"], x["redacted"],
                     ("YES", "error") if x["present_at_head"] == "YES" else "no", x["first_added_utc"],
                     x["first_added_by"].split(" <")[0], x["last_removed_utc"] or "—", x["first_file"]]
                    for x in shown],
                   [7, 24, 26, 4, 19, 14, 19, 30], color)
        if len(gen) > generic_limit:
            L.append(paint(f"  … and {len(gen) - generic_limit} more generic finding(s) in docs_secret_summary.tsv "
                           "(raise with --show-generic N)", "dim", color))
        L.append(paint(f"  Files: {st['output_dir']}/docs_secret_summary.tsv (one row per secret), "
                       "docs_secret_findings.tsv (every occurrence)", "dim", color))
    L += ["", paint("  Values are redacted. To check a known secret without sharing it: echo -n 'VALUE' | sha256sum,\n"
                    "  then search for that hash in the secret_sha256 column. Commit times are UTC; they come from\n"
                    "  the commit itself and can be forged.", "dim", color), "", rule]
    return "\n".join(L) + "\n"


TOKEN_LINE = re.compile(r"""^GITHUB_TOKEN\s*=\s*["']([^"']*)["']""", re.MULTILINE)


def find_token():
    """Same lookup as ghimpact/ghtokenusage: ghworkflowhunt next to this script, then env."""
    here = Path(__file__).resolve().parent
    for name in ("ghworkflowhunt", "gh_workflow_hunt.py"):
        p = here / name
        if p.is_file():
            m = TOKEN_LINE.search(p.read_text(encoding="utf-8", errors="replace"))
            if m and m.group(1).strip():
                return m.group(1).strip(), name
    for var in ("GITHUB_TOKEN", "GH_TOKEN"):
        if os.environ.get(var, "").strip():
            return os.environ[var].strip(), f"${var}"
    return "", ""


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("repos", nargs="+", help="owner/repo, or a path to a local clone/mirror")
    ap.add_argument("--path", action="append", help="path in repo to scan; repeatable (default: docs)")
    ap.add_argument("--all-paths", action="store_true", help="scan the entire repo history")
    ap.add_argument("--out", default="evidence", help="evidence dir (shared with gh_workflow_hunt.py)")
    ap.add_argument("--no-color", action="store_true", help="disable colored output")
    ap.add_argument("-v", "--version", action="version", version=f"%(prog)s {__version__}")
    ap.add_argument("--no-token", action="store_true",
                    help="clone anonymously (public repos only) even if a token is available")
    ap.add_argument("--report-only", action="store_true",
                    help="don't scan: rebuild the report from an earlier run's TSVs in --out (fast)")
    ap.add_argument("--show-generic", type=int, default=10, metavar="N",
                    help="generic findings to list per repo in the report (default 10; all are in the TSVs)")
    ap.add_argument("--unredacted", action="store_true",
                    help="also write plaintext secret values (sensitive!)")
    a = ap.parse_args()
    a.repos = normalize_repos(a.repos, allow_paths=True)
    global USE_COLOR, USE_COLOR_OUT
    if a.no_color:
        USE_COLOR = USE_COLOR_OUT = False

    paths = [] if a.all_paths else (a.path or DEFAULT_PATHS)
    if not a.report_only:
        token, src = ("", "") if a.no_token else find_token()
        log(f"git access: {set_git_auth(token)}" + (f" · token from {src}" if src else ""))
    evidence = Path(a.out)
    evidence.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    results = {}
    log(f"{len(a.repos)} repo(s); scope: {', '.join(paths) if paths else 'entire repo'}")
    for repo in a.repos:
        log(f"== {repo}", "head")
        try:
            stats, summary = (load_previous(repo, evidence) if a.report_only
                              else hunt(repo, evidence, paths, a.unredacted))
            results[repo] = {"stats": stats, "summary": summary}
        except RuntimeError as e:
            reason = clone_error(str(e))
            log(f"  ERROR: {reason}", "error")
            results[repo] = {"error": reason}

    meta = {"collected": datetime.strptime(stamp, "%Y%m%dT%H%M%SZ").strftime("%Y-%m-%d %H:%M:%S"),
            "paths": ["(from earlier run's TSVs)"] if a.report_only else paths, "rules": len(RULES), "rules_high": sum(1 for r in RULES if r[1] != "generic")}
    (evidence / f"secret_hunt_{stamp}.json").write_text(json.dumps(
        {"meta": meta, "repos": {r: (d if "error" in d else d["stats"]) for r, d in results.items()}}, indent=2))
    plain = render(meta, results, False, a.show_generic)
    for name in (f"secret_hunt_{stamp}.txt", "secret_hunt.txt"):
        (evidence / name).write_text(plain, encoding="utf-8")
    try:
        sys.stdout.write(render(meta, results, USE_COLOR_OUT, a.show_generic))
    except UnicodeEncodeError:
        sys.stdout.write(plain.encode("ascii", "replace").decode())
    log(f"report saved to {evidence / 'secret_hunt.txt'} (and secret_hunt_{stamp}.txt); "
        f"machine-readable copy in secret_hunt_{stamp}.json", "ok")


if __name__ == "__main__":
    main()
