def parse_bound(value, end=False):
    """'YYYY-MM-DD' or ISO date-time -> aware UTC datetime. A bare date as an end bound
    means the end of that day (inclusive)."""
    v = value.strip()
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}", v):
        d = datetime.strptime(v, "%Y-%m-%d").replace(tzinfo=timezone.utc)
        return d + timedelta(days=1, seconds=-1) if end else d
    try:
        d = datetime.fromisoformat(v.replace("Z", "+00:00"))
    except ValueError:
        die(f"can't parse date/time {value!r}; use YYYY-MM-DD or 2026-10-23T14:00:00Z")
    return (d if d.tzinfo else d.replace(tzinfo=timezone.utc)).astimezone(timezone.utc)


def _iso(dt):
    return dt.strftime("%Y-%m-%dT%H:%M:%SZ")


RUN_CAP = 1000  # GitHub returns at most 1,000 runs per filtered listing


def list_runs(repo, token, since, until=None):
    """Every run created in [since, until]. GitHub caps a filtered listing at 1,000 runs,
    so a window that hits the cap is split in half (repeatedly) until each piece fits.

    Returns (runs, windows). Each window records GitHub's own total_count next to what
    was collected; totals are exact below the cap (GitHub's count for large windows is
    not, e.g. it stops at 2,500), so matching leaf windows prove the list is complete."""
    start = parse_bound(since)
    end = parse_bound(until, end=True) if until else datetime.now(timezone.utc)
    seen, out, gaps, leaves = set(), [], [], []
    windows = 0

    def fetch(a, b):
        nonlocal windows
        windows += 1
        got, page, total = [], 1, None
        while True:
            data = gh_json(f"/repos/{repo}/actions/runs", token,
                           {"created": f"{_iso(a)}..{_iso(b)}", "per_page": 100, "page": page})
            if not data:
                break
            if total is None:
                total = data.get("total_count")
            runs = data.get("workflow_runs", [])
            got += runs
            if len(runs) < 100 or len(got) >= RUN_CAP:
                break
            page += 1
        if len(got) >= RUN_CAP:
            if (b - a).total_seconds() > 1:
                mid = a + (b - a) / 2
                log(f"    {len(got)}+ runs in {_iso(a)}..{_iso(b)}: splitting the window to get them all")
                fetch(a, mid)
                fetch(mid + timedelta(seconds=1), b)
                return
            gaps.append(f"{_iso(a)}..{_iso(b)}")
        ids = {r["id"] for r in got}
        status = ("OK" if total == len(ids) else
                  "DELETED?" if total is not None and total < len(ids) else "SHORT")
        leaves.append({"window_start_utc": _iso(a), "window_end_utc": _iso(b),
                       "github_total": "" if total is None else total, "collected": len(ids), "status": status})
        for r in got:
            if r["id"] not in seen:
                seen.add(r["id"])
                out.append(r)

    fetch(start, end)
    if windows > 1:
        log(f"  run listing split into {windows} windows to stay under GitHub's 1,000-run cap")
    for g in gaps:
        log(f"  WARNING: more than 1,000 runs within one second ({g}); some may be missing", "warn")
    out.sort(key=lambda r: r.get("created_at") or "", reverse=True)
    short = [w for w in leaves if w["status"] == "SHORT"]
    if short:
        log(f"  WARNING: {len(short)} window(s) returned fewer runs than GitHub reports; see "
            "api_runs_windows.tsv and re-run those windows", "warn")
    return out, leaves


def workflow_at_sha(repo, path, sha, token, cache):
    key = (path, sha)
    if key in cache:
        return cache[key]
    clean = path.split("@")[0]
    content = None
    if clean.startswith(".github/"):
        data = gh_json(f"/repos/{repo}/contents/{urllib.parse.quote(clean)}", token, {"ref": sha})
        if data and data.get("encoding") == "base64":
            content = base64.b64decode(data["content"]).decode("utf-8", "replace")
    cache[key] = content
    return content


def hunt_api(repo, token, since, until, rules, repo_dir: Path, mirror: Path, download):
    runs_dir = repo_dir / "runs"
    all_runs, rows, cache = [], [], {}
    evidence_for_version = {}  # (path, sha) -> run_id holding full evidence
    listed, leaves = list_runs(repo, token, since, until)
    all_runs.extend(listed)
    write_tsv(repo_dir / "api_runs_windows.tsv", leaves,
              ["window_start_utc", "window_end_utc", "github_total", "collected", "status"])
    n_ok = sum(1 for w in leaves if w["status"] == "OK")
    if leaves and n_ok == len(leaves):
        completeness = f"verified ({len(leaves)} window{'s' if len(leaves) != 1 else ''}, all match GitHub's count)"
    else:
        bad = [w for w in leaves if w["status"] != "OK"]
        completeness = (f"CHECK: {len(bad)} of {len(leaves)} windows differ from GitHub's count "
                        f"(see api_runs_windows.tsv)")
    (repo_dir / "api_runs_completeness.txt").write_text(completeness)
    log(f"  {len(all_runs)} runs since {since}; run list {completeness}",
        "ok" if completeness.startswith("verified") else "warn")
    (repo_dir / "api_runs_all.json").write_text(json.dumps(all_runs, indent=2))

    for run in all_runs:
        rid, sha, path = run["id"], run.get("head_sha"), run.get("path", "")
        text_fields = " ".join(str(run.get(k) or "") for k in
                               ("name", "display_title", "path", "head_branch"))
        text_fields += " " + str((run.get("head_commit") or {}).get("message") or "")
        yml = workflow_at_sha(repo, path, sha, token, cache) if sha and path else None
        meta_strong = match(text_fields, rules.strong)
        yml_strong = match(yml, rules.strong)
        yml_weak = match(yml, rules.weak)  # weak patterns are judged on YAML only
        tier = rules.tier(meta_strong + yml_strong, yml_weak)
        via = "+".join(x for x, hit in (("meta", meta_strong), ("yaml", yml_strong)) if hit)

        # Strong hits: full evidence for EVERY run (each attacker run may exfiltrate
        # different data). Weak-combo: full evidence once per workflow version.
        version = (path, sha)
        full = tier == "strong" or (tier and version not in evidence_for_version)
        if tier and full:
            evidence_for_version.setdefault(version, rid)
        row = {
            "run_id": rid, "flagged": tier,
            "evidence_run_id": (rid if full else evidence_for_version.get(version, "")) if tier else "",
            "matched_via": via,
            "strong_metadata": labels(meta_strong), "strong_yaml": labels(yml_strong),
            "weak_yaml": labels(yml_weak),
            "executed": "", "logs": "", "artifacts": "", "artifact_detail": "",
            "upload_step": "", "upload_artifact_ids": "", "upload_digest": "",
            "upload_size_bytes": "", "upload_time_utc": "", "artifact_api_state": "",
            "expected_artifacts": ";".join(artifact_names(yml)),
            "created_at": run.get("created_at"), "updated_at": run.get("updated_at"),
            "event": run.get("event"), "status": run.get("status"),
            "conclusion": run.get("conclusion"), "name": run.get("name"),
            "display_title": run.get("display_title"), "path": path,
            "head_branch": run.get("head_branch"), "head_sha": sha,
            "actor": (run.get("actor") or {}).get("login"),
            "triggering_actor": (run.get("triggering_actor") or {}).get("login"),
            "head_repo": (run.get("head_repository") or {}).get("full_name"),
            "run_attempt": run.get("run_attempt"), "url": run.get("html_url"),
            "yaml_retrieved": "yes" if yml is not None else "no",
        }
        rows.append(row)
        if not tier:
            continue

        where = f"{Path(path).name} @ {(sha or '')[:12]}, branch {row['head_branch']}"
        if tier == "strong":
            hits = []
            if meta_strong:
                hits.append(f"metadata: {labels(meta_strong)}")
            if yml_strong:
                hits.append(f"yaml: {labels(yml_strong)}")
            log(f"  FLAGGED run {rid} ({where}) by {row['actor']} | {' | '.join(hits)}", "flag")
        elif full:
            log(f"  weak-combo run {rid} ({where}) | yaml: {labels(yml_weak)}; "
                "collecting once for this workflow version", "warn")
        rd = runs_dir / str(rid)
        rd.mkdir(parents=True, exist_ok=True)
        (rd / "run.json").write_text(json.dumps(run, indent=2))
        if not full:
            row["logs"] = row["artifacts"] = f"see run {row['evidence_run_id']}"
            continue  # same weak-combo workflow version already collected
        if yml is not None:
            (rd / Path(path.split("@")[0]).name).write_text(yml)
        if sha:
            fetch_sha(mirror, sha, f"refs/dfir/runs/{rid}")
        jobs = gh_json(f"/repos/{repo}/actions/runs/{rid}/jobs", token,
                       {"filter": "all", "per_page": 100})
        if jobs:
            (rd / "jobs.json").write_text(json.dumps(jobs, indent=2))
        row["executed"] = executed_state(run, jobs)
        if row["executed"] == "no" and tier == "strong":
            log(f"    run {rid} never executed (conclusion: {row['conclusion']}); "
                "no logs or artifacts were ever created", "ok")
        if not download:
            row["logs"] = row["artifacts"] = "not collected"
            continue

        st = gh_download(f"/repos/{repo}/actions/runs/{rid}/logs", token, rd / "logs.zip")
        if st == 200:
            row["logs"] = "collected"
        elif st in (404, 410) and row["executed"] == "no":
            row["logs"] = "none (never ran)"
        elif st in (404, 410):
            row["logs"] = f"GONE ({st})"
            log(f"    logs for run {rid} are gone ({st}) although it ran: likely deleted", "warn")
        else:
            row["logs"] = f"error {st}"
            log(f"    logs for run {rid}: HTTP {st}", "warn")

        arts = gh_json(f"/repos/{repo}/actions/runs/{rid}/artifacts", token, {"per_page": 100})
        if arts is None:
            row["artifacts"] = "error"
            continue
        (rd / "artifacts.json").write_text(json.dumps(arts, indent=2))
        listed = arts.get("artifacts", [])
        got = expired = failed = 0
        for a in listed:
            if a.get("expired"):
                expired += 1
                log(f"    artifact {a['name']} expired", "warn")
                continue
            safe = re.sub(r"[^\w.-]", "_", a["name"])
            if gh_download(a["archive_download_url"], token,
                           rd / "artifacts" / f"{a['id']}_{safe}.zip") == 200:
                got += 1
            else:
                failed += 1
        up = analyze_upload(rd / "logs.zip", jobs) if row["executed"] != "no" else None
        if up:
            row.update({"upload_step": up["step"], "upload_artifact_ids": ";".join(up["ids"]),
                        "upload_digest": up["digest"], "upload_size_bytes": up["size"],
                        "upload_time_utc": up["time"]})
        if listed:
            parts = [f"{got} collected"] + ([f"{expired} expired"] if expired else []) \
                + ([f"{failed} failed"] if failed else [])
            row["artifacts"] = ", ".join(parts)
        elif row["executed"] == "no":
            row["artifacts"] = "n/a"
        elif up and up["ids"]:
            # The log proves an artifact was uploaded; ask the API about each ID directly.
            states = {i: artifact_state(repo, token, i) for i in up["ids"]}
            row["artifact_api_state"] = ";".join(f"{i}={v}" for i, v in states.items())
            days = retention_days(yml)
            age = None
            if up["time"]:
                age = (datetime.now(timezone.utc)
                       - datetime.strptime(up["time"][:19], "%Y-%m-%d %H:%M:%S").replace(tzinfo=timezone.utc)).days
            if all(v == "not found" for v in states.values()):
                if days is not None and age is not None and age >= days:
                    row["artifacts"] = "EXPIRED"
                    row["artifact_detail"] = (f"uploaded; the workflow set retention-days: {days}, which has passed, "
                                              "and the API returns 404. Most likely expired; an artifact.destroy "
                                              "audit event would mean it was deleted first")
                else:
                    row["artifacts"] = "DELETED"
                    row["artifact_detail"] = ("uploaded (log shows artifact ID), now 404 from the API; "
                                              + (f"retention-days: {days} not yet reached" if days is not None
                                                 else "default retention not reached"))
                    log(f"    run {rid}: artifact {', '.join(up['ids'])} was uploaded and is now gone: DELETED",
                        "flag")
            elif any(v == "expired" for v in states.values()):
                row["artifacts"] = "EXPIRED"
                row["artifact_detail"] = "uploaded, API reports it expired"
            else:
                row["artifacts"] = "UNLISTED"
                row["artifact_detail"] = f"uploaded; API lookup by ID: {row['artifact_api_state']}"
        elif up and up["no_files"]:
            row["artifacts"] = "NOT UPLOADED"
            row["artifact_detail"] = "upload step ran but found no files (an earlier step likely produced nothing)"
        elif up and up["step"] and all(c in ("skipped", "failure", "cancelled") for c in up["step"].split(";")):
            row["artifacts"] = "NOT UPLOADED"
            row["artifact_detail"] = f"upload step did not succeed ({up['step']})" + (
                f": {up['error']}" if up["error"] else "")
        elif row["expected_artifacts"]:
            row["artifacts"] = "MISSING"
            row["artifact_detail"] = ("expected upload, but " +
                                      ("logs are gone" if "GONE" in row["logs"] else "no upload record in the logs"))
            log(f"    run {rid}: expected artifact {row['expected_artifacts']} but found no upload record", "warn")
        else:
            row["artifacts"] = "none"
        if row["artifact_detail"] and row["artifacts"] != "DELETED":
            log(f"    run {rid}: artifact {row['artifacts']}: {row['artifact_detail']}",
                "warn" if row["artifacts"] in ("MISSING", "UNLISTED") else "info")

    if rows:
        write_tsv(repo_dir / "api_runs.tsv", rows)
    return rows


# --------------------------------------------------------------------------- report

def _fit(text, width):
    text = "" if text is None else str(text)
    return text if len(text) <= width else text[:max(1, width - 1)] + "…"


def table(headers, rows, widths, color, indent="  "):
    """rows: list of lists of str or (str, style). Returns lines."""
    def cell(v, w):
        txt, style = v if isinstance(v, tuple) else (v, "")
        txt = _fit(txt, w).ljust(w)
        return paint(txt, style, color) if style else txt
    out = [(indent + "  ".join(_fit(h, w).ljust(w) for h, w in zip(headers, widths))).rstrip(),
           indent + "  ".join("─" * w for w in widths)]
    out[0] = paint(out[0], "head", color)
    for r in rows:
        out.append(indent + "  ".join(cell(v, w) for v, w in zip(r, widths)).rstrip())
    return out


def _ts(iso):
    """Any ISO-8601 time -> 'YYYY-MM-DD HH:MM:SS' in UTC."""
    if not iso:
        return ""
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone(timezone.utc).strftime("%Y-%m-%d %H:%M:%S")
    except ValueError:
        return iso.replace("T", " ")[:19]


def _ran(v):
    return {"yes": ("yes", "flag"), "no": ("no", "ok"), "unknown": ("?", "warn")}.get(v, v)


def _st(v):
    if "GONE" in v or v in ("MISSING", "DELETED", "UNLISTED"):
        return v, "error"
    if v in ("NOT UPLOADED", "EXPIRED"):
        return v, "warn"
    if "never ran" in v or v == "n/a":
        return v, "dim"
    if "collected" in v:
        return v, "ok"
    return v


def _count(values):
    c = {}
    for v in values:
        c[v] = c.get(v, 0) + 1
    return ", ".join(f"{k} ({n})" for k, n in sorted(c.items(), key=lambda kv: -kv[1])) or "—"


def classify(runs):
    """Group one repo's runs the way the report presents them."""
    strong = sorted([r for r in runs if r["flagged"] == "strong"], key=lambda r: r["created_at"] or "")
    weak = sorted([r for r in runs if r["flagged"] == "weak-combo"], key=lambda r: r["created_at"] or "")
    flagged = strong + weak
    return {
        "strong": strong, "weak": weak,
        "gaps": [r for r in flagged if r["executed"] != "no" and
                 ("GONE" in r["logs"] or r["artifacts"] in ("DELETED", "MISSING", "UNLISTED"))],
        "uploads": [r for r in flagged if r["executed"] == "yes" and
                    (r["expected_artifacts"] or r["upload_artifact_ids"] or r["upload_step"])],
        "ran_code": [r for r in strong if "yaml" in r["matched_via"] and r["executed"] == "yes"],
        "never_ran": [r for r in strong if "yaml" in r["matched_via"] and r["executed"] == "no"],
        "kept": sum(int(m.group(1)) for r in flagged for m in [re.match(r"(\d+) collected", r["artifacts"])] if m),
        "lost": sum(1 for r in flagged if r["artifacts"] in ("DELETED", "EXPIRED")),
    }


def render_report(meta, repos, color):
    W = 78
    L = []
    rule = paint("═" * W, "head", color)
    L += [rule, paint(f" GitHub workflow hunt — summary".ljust(W - 22) + f"ghworkflowhunt {__version__}", "head", color), rule]

    def kv(k, v, style=""):
        L.append(f"  {k:<27}{paint(str(v), style, color) if style else v}")

    kv("Collected (UTC)", meta["collected"])
    kv("Run window", f"{meta['since']} → {meta['until'] or 'now'}")
    kv("Strong patterns", labels(meta["patterns"]["strong"]) or "—")
    wt = meta["patterns"]["weak_threshold"]
    kv("Weak patterns", (labels(meta["patterns"]["weak"]) + f"  (flag at {wt}+)") if wt
       else "recorded only (weak-combo flagging off)")

    for repo, why in meta.get("failed", {}).items():
        kv("SKIPPED (clone failed)", f"{repo}: {why}", "error")
    groups = {repo: classify(d["runs"]) for repo, d in repos.items()}

    def severity(repo):
        g, st = groups[repo], repos[repo]["stats"]
        return (-len(g["ran_code"]), -len(g["gaps"]), -st["runs_flagged_strong"],
                -st["workflow_commits_flagged_strong"], -len(repos[repo]["refs"]), repo)

    order = sorted(repos, key=severity)  # most serious first

    if len(repos) > 1:
        hit = [r for r in order if groups[r]["strong"] or groups[r]["weak"]
               or repos[r]["stats"]["workflow_commits_flagged_strong"] or repos[r]["refs"]]
        kv("Repos scanned", f"{len(repos)}  ({len(hit)} with findings, {len(repos) - len(hit)} clean)",
           "flag" if hit else "ok")
        L += ["", paint("  All repos at a glance (most serious first)", "head", color)]

        def n(v, style):
            return (str(v), style) if v else ("0", "dim")

        rows = []
        for r in order:
            g, st = groups[r], repos[r]["stats"]
            actors = _count(x["actor"] for x in g["strong"]) if g["strong"] else "—"
            rows.append([(r, "flag") if g["ran_code"] else r,
                         n(st["runs_flagged_strong"], "flag"), n(len(g["ran_code"]), "flag"),
                         n(len(g["never_ran"]), "ok"), n(len(g["gaps"]), "error"),
                         n(g["kept"], "ok"), n(g["lost"], "warn"),
                         n(st["workflow_commits_flagged_strong"], "flag"), n(len(repos[r]["refs"]), "flag"),
                         actors])
        L += table(["Repo", "Flagged", "Executed", "Never ran", "Gaps", "Art kept", "Art lost",
                    "Commits", "Refs", "Actors"],
                   rows, [32, 7, 8, 9, 4, 8, 8, 7, 4, 24], color)
        L.append(paint("  Flagged = strong-flagged runs. Executed = attacker YAML that actually ran (exfiltration\n"
                       "  scope). Gaps = runs that ran but are missing logs/artifacts. Art kept = artifacts\n"
                       "  collected; Art lost = DELETED or EXPIRED. Commits = flagged workflow file changes.\n"
                       "  Refs = suspicious branch/tag names. Details per repo follow, in this order.",
                       "dim", color))

    for repo in order:
        d = repos[repo]
        s, runs, commits, refs = d["stats"], d["runs"], d["commits"], d["refs"]
        L += ["", paint(f"── {repo} " + "─" * max(3, W - len(repo) - 4), "head", color)]
        g = groups[repo]
        strong_runs, weak_runs = g["strong"], g["weak"]
        flagged_commits = [c for c in commits if c["flagged"]]
        gaps, uploads, ran_code, never_ran = g["gaps"], g["uploads"], g["ran_code"], g["never_ran"]

        kv("Runs in window", s["runs_total"])
        if s.get("runs_complete"):
            kv("Run list", s["runs_complete"], "ok" if s["runs_complete"].startswith("verified") else "error")
        kv("Flagged runs (strong)", s["runs_flagged_strong"], "flag" if s["runs_flagged_strong"] else "ok")
        kv("Flagged runs (weak-combo)", s["runs_flagged_weak_combo"], "warn" if s["runs_flagged_weak_combo"] else "")
        kv("Attacker code executed", f"{len(ran_code)} runs" if ran_code else "0",
           "flag" if ran_code else "ok")
        kv("Attacker code never ran", f"{len(never_ran)} runs (held for approval, skipped, or failed to start)"
           if never_ran else "0", "ok" if never_ran else "")
        kv("Runs missing evidence", len(gaps), "error" if gaps else "ok")
        kv("YAML not retrievable", s["runs_yaml_missing"], "warn" if s["runs_yaml_missing"] else "")
        kv("Workflow commits", f"{s['workflow_commit_count']} ({s['workflow_commits']} file changes)")
        kv("Flagged file changes", f"{s['workflow_commits_flagged_strong']} strong, "
           f"{s['workflow_commits_flagged_weak_combo']} weak-combo",
           "flag" if s["workflow_commits_flagged_strong"] else "")
        kv("Suspicious refs", len(refs) if refs else
           ("0  (attacker branches were likely deleted)" if strong_runs else "0"),
           "flag" if refs else "")
        if strong_runs:
            kv("Actors on flagged runs", _count(r["actor"] for r in strong_runs))
            kv("Events on flagged runs", _count(r["event"] for r in strong_runs))
            kv("Attacker workflow files", _count(Path(r["path"]).name for r in strong_runs if "yaml" in r["matched_via"]))

        for title, rs in (("Strong-flagged runs", strong_runs), ("Weak-combo runs", weak_runs)):
            if not rs:
                continue
            L += ["", paint(f"  {title} ({len(rs)}, oldest first)", "head", color)]
            L += table(
                ["Run ID", "Created (UTC)", "Event", "Branch", "Workflow", "Via", "Ran", "Result", "Logs", "Artifacts"],
                [[str(r["run_id"]), _ts(r["created_at"]), r["event"], r["head_branch"],
                  Path(r["path"] or "").name, r["matched_via"], _ran(r["executed"]),
                  r["conclusion"] or r["status"], _st(r["logs"]), _st(r["artifacts"])] for r in rs],
                [11, 19, 17, 14, 19, 9, 3, 15, 16, 12], color)
            L.append(paint("  Via: meta = matched branch/title/commit message; yaml = matched the workflow file.\n"
                           "  Ran: whether any job step executed on a runner (from the run's job details).", "dim", color))

        if ran_code:
            L += ["", paint(f"  Attacker code that executed ({len(ran_code)})", "flag", color)]
            L += table(["Run ID", "Created (UTC)", "Workflow", "Branch", "Result", "Logs", "Artifacts"],
                       [[str(r["run_id"]), _ts(r["created_at"]), Path(r["path"]).name, r["head_branch"],
                         r["conclusion"], _st(r["logs"]), _st(r["artifacts"])] for r in ran_code],
                       [11, 19, 22, 14, 10, 16, 12], color)
            L.append(paint("  These runs define the exfiltration scope. Review their logs and artifacts first.", "dim", color))

        if never_ran:
            L += ["", paint(f"  Attacker workflows that never executed ({len(never_ran)})", "ok", color)]
            for r in never_ran:
                L.append(f"  {paint('○', 'ok', color)} {r['run_id']}  {_ts(r['created_at'])}  "
                         f"{Path(r['path']).name:<20} {r['conclusion']}")
            L.append(paint("  No job ran, so no logs or artifacts were ever created and nothing was exfiltrated by\n"
                           "  these runs. Confirm no one approved them later: re-run this script, or check the audit log.",
                           "dim", color))

        if uploads:
            L += ["", paint(f"  Artifact upload checks ({len(uploads)}, from each run's logs + API lookup by ID)",
                            "head", color)]
            L += table(["Run ID", "Workflow", "Upload step", "Artifact ID", "Bytes", "Uploaded (UTC)", "Status"],
                       [[str(r["run_id"]), Path(r["path"]).name, r["upload_step"] or "—",
                         r["upload_artifact_ids"] or "—", r["upload_size_bytes"] or "—",
                         r["upload_time_utc"][:19] or "—", _st(r["artifacts"])] for r in uploads],
                       [11, 19, 11, 12, 9, 19, 12], color)
            for r in uploads:
                if r["artifact_detail"]:
                    L.append(f"    {r['run_id']}: {r['artifact_detail']}")
                if r["upload_digest"]:
                    L.append(paint(f"    {r['run_id']}: SHA-256 from log {r['upload_digest']}", "dim", color))
            L.append(paint("  DELETED = the log shows an artifact ID, and the API now returns 404 for it before its\n"
                           "  retention ran out. EXPIRED = uploaded, but past its retention (check retention-days in\n"
                           "  the YAML; a short value is a way to make evidence vanish). NOT UPLOADED = the run's own\n"
                           "  logs show no artifact was created.",
                           "dim", color))

        if gaps:
            L += ["", paint(f"  Evidence gaps ({len(gaps)})", "error", color)]
            for r in gaps:
                what = []
                if "GONE" in r["logs"]:
                    what.append(f"logs {r['logs']}")
                if r["artifacts"] in ("DELETED", "MISSING", "UNLISTED"):
                    ids = f" ID {r['upload_artifact_ids']}" if r["upload_artifact_ids"] else ""
                    what.append(f"artifact {r['artifacts']}{ids} (expected: {r['expected_artifacts'] or '?'})")
                L.append(f"  {paint('✗', 'error', color)} {r['run_id']}  {_ts(r['created_at'])}  "
                         f"{Path(r['path']).name}  —  {'; '.join(what)}")
            L.append(paint("  These runs executed, but evidence is missing. Deleting logs or artifacts needs write\n"
                           "  access. Look for the matching artifact.destroy / checks.delete_logs audit log events.",
                           "dim", color))

        aud = d.get("audit")
        if aud is not None:
            ev, err = aud
            L += ["", paint("  Audit log: artifact and log deletions", "head", color)]
            if err:
                L.append(paint(f"  Not available ({err}).", "warn", color))
            elif not ev:
                L.append("  No artifact.destroy or checks.delete_logs events for this repo in the window.")
            else:
                ids = {i for r in runs for i in r["upload_artifact_ids"].split(";") if i}
                rows_ = []
                for e in sorted(ev, key=lambda e: e.get("@timestamp") or e.get("created_at") or 0):
                    t = e.get("@timestamp") or e.get("created_at")
                    t = datetime.fromtimestamp(t / 1000, timezone.utc).strftime("%Y-%m-%d %H:%M:%S") \
                        if isinstance(t, (int, float)) else str(t)
                    hit = sorted(i for i in ids if i in json.dumps(e))
                    rows_.append([t, e.get("action", ""), e.get("actor", ""),
                                  (", ".join(hit), "flag") if hit else "—"])
                L += table(["Time (UTC)", "Action", "Actor", "Matches artifact ID"], rows_, [19, 20, 18, 20], color)
                L.append(paint("  Raw events are saved in audit_log_events.json.", "dim", color))

        if aud is None and gaps:
            L.append(paint("  Deletion events not checked. Re-run with --audit-log and an org owner token, or search\n"
                           "  the org audit log for action:artifact.destroy and action:checks.delete_logs.",
                           "dim", color))

        if flagged_commits:
            fc = sorted(flagged_commits, key=lambda c: c["committer_date_utc"])
            L += ["", paint(f"  Flagged workflow file changes ({len(fc)}, oldest first)", "head", color)]
            L += table(
                ["Committed (UTC)", "Commit", "Chg", "File", "Author", "Matched"],
                [[c["committer_date_utc"], c["commit"][:12], c["change"],
                  c["file"].replace(".github/workflows/", ""), c["author"].split(" <")[0],
                  "; ".join(x for x in (c["strong_added"] and f"+ {c['strong_added']}",
                                        c["strong_removed"] and f"- {c['strong_removed']}",
                                        not (c["strong_added"] or c["strong_removed"]) and f"weak: {c['weak_added'] or c['weak_removed']}") if x)]
                 for c in fc],
                [19, 12, 3, 22, 14, 40], color)
            L.append(paint("  Chg: A = added (new file), M = modified, D = deleted, R = renamed.", "dim", color))
            offs = {}
            for c in fc:
                key = (c["committer_tz"] or "?", c["author"].split(" <")[0])
                offs[key] = offs.get(key, 0) + 1
            L.append("  Original commit time zones: " + ", ".join(
                f"{tz} x{n} ({who})" for (tz, who), n in sorted(offs.items(), key=lambda kv: -kv[1])))
            L.append(paint("  All times in this report are UTC. The original offset is recorded by the machine that\n"
                           "  made the commit; different offsets or name formats for one person can mean different\n"
                           "  machines, or commits made through the GitHub web/API. Commit dates can be forged, so\n"
                           "  build the timeline from run times (ghimpact writes impact_timeline.tsv).", "dim", color))

        if refs:
            L += ["", paint(f"  Suspicious refs ({len(refs)})", "flag", color)]
            L += [f"    {r.replace(chr(9), '  ')}" for r in refs]

        L += ["", paint("  Files", "head", color)]
        for f in d["files"]:
            L.append(f"    {f}")
    L += ["", rule]
    return "\n".join(L) + "\n"


# --------------------------------------------------------------------------- verify-only

EXACT_BELOW = 1000  # GitHub's total_count is only trusted for windows smaller than this


def count_windows(repo, token, times, start, end):
    """Compare GitHub's total_count with the collected runs, window by window, splitting any
    window whose GitHub total is too large to be exact. One small API call per window."""
    leaves = []

    def check(a, b):
        d = gh_json(f"/repos/{repo}/actions/runs", token,
                    {"created": f"{_iso(a)}..{_iso(b)}", "per_page": 1})
        total = d.get("total_count") if d else None
        if total is None:
            leaves.append({"window_start_utc": _iso(a), "window_end_utc": _iso(b), "github_total": "",
                           "collected": "", "status": "ERROR"})
            return
        if total >= EXACT_BELOW and (b - a).total_seconds() > 1:
            mid = a + (b - a) / 2
            check(a, mid)
            check(mid + timedelta(seconds=1), b)
            return
        mine = sum(1 for t in times if a <= t <= b)
        status = "OK" if total == mine else ("SHORT" if total > mine else "DELETED?")
        leaves.append({"window_start_utc": _iso(a), "window_end_utc": _iso(b), "github_total": total,
                       "collected": mine, "status": status})

    check(start, end)
    return leaves


def run_window_from_summaries(out: Path, repo):
    """(since, until, collected_utc) recorded by the newest earlier run that covered this repo."""
    for f in sorted(out.glob("summary_*.json"), reverse=True):
        try:
            d = json.loads(f.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if repo in d.get("repos", {}):
            return d.get("since"), d.get("until"), d.get("collected_utc")
    return None, None, None


def verify_only(a, token):
    out = Path(a.out)
    if not out.is_dir():
        die(f"--verify-only: evidence folder {out} not found")
    repos = a.repos or sorted(d.name.replace("__", "/", 1) for d in out.iterdir()
                              if (d / "api_runs_all.json").exists())
    if not repos:
        die(f"--verify-only: no api_runs_all.json files under {out}")
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    results, all_rows = [], []
    for repo in repos:
        f = out / repo.replace("/", "__") / "api_runs_all.json"
        if not f.exists():
            results.append({"repo": repo, "status": "NO DATA", "detail": f"{f} not found"})
            continue
        runs = json.loads(f.read_text())
        times = [parse_bound(r["created_at"]) for r in runs if r.get("created_at")]
        ids = [r["id"] for r in runs]
        s_since, s_until, s_coll = run_window_from_summaries(out, repo)
        since = a.since or s_since
        if not since:
            results.append({"repo": repo, "status": "NO WINDOW",
                            "detail": "no summary_*.json for this repo; pass --since (and --until) as used originally"})
            continue
        start = parse_bound(since)
        until = a.until or s_until
        # No --until in the original run: the listing ended when it ran, after the newest run it saw.
        end = (parse_bound(until, end=True) if until else
               max(times) if times else
               datetime.strptime(s_coll, "%Y%m%dT%H%M%SZ").replace(tzinfo=timezone.utc) if s_coll
               else datetime.now(timezone.utc))
        log(f"== {repo}: checking {len(runs)} collected runs, {_hms(_iso(start))} → {_hms(_iso(end))} UTC", "head")
        leaves = count_windows(repo, token, times, start, end)
        for w in leaves:
            all_rows.append({"repo": repo, **w})
        bad = [w for w in leaves if w["status"] != "OK"]
        gh_sum = sum(w["github_total"] for w in leaves if isinstance(w["github_total"], int))
        dupes = len(ids) - len(set(ids))
        outside = sum(1 for t in times if not (start <= t <= end))
        status = ("VERIFIED" if not bad and not dupes else
                  "SHORT" if any(w["status"] == "SHORT" for w in bad) else
                  "ERROR" if any(w["status"] == "ERROR" for w in bad) else
                  "DELETED?" if bad else "DUPLICATES")
        results.append({"repo": repo, "status": status, "collected": len(runs), "github": gh_sum,
                        "windows": len(leaves), "bad": bad, "dupes": dupes, "outside": outside,
                        "window": f"{_hms(_iso(start))} → {_hms(_iso(end))}",
                        "source": "command line" if a.since else "original run's summary"})
        log(f"   {status}: {len(runs)} collected, GitHub counts {gh_sum} in {len(leaves)} window(s)",
            "ok" if status == "VERIFIED" else "error")

    write_tsv(out / f"verify_runs_{stamp}.tsv", all_rows,
              ["repo", "window_start_utc", "window_end_utc", "github_total", "collected", "status"])
    plain = render_verify(results, stamp, out, False)
    for name in (f"verify_runs_{stamp}.txt", "verify_runs.txt"):
        (out / name).write_text(plain, encoding="utf-8")
    try:
        sys.stdout.write(render_verify(results, stamp, out, USE_COLOR_OUT))
    except UnicodeEncodeError:
        sys.stdout.write(plain.encode("ascii", "replace").decode())
    log(f"report saved to {out / 'verify_runs.txt'}; per-window detail in verify_runs_{stamp}.tsv", "ok")
    sys.exit(0 if all(r["status"] == "VERIFIED" for r in results) else 1)


def _hms(iso_z):
    return iso_z.replace("T", " ").rstrip("Z")


def render_verify(results, stamp, out, color):
    W = 78
    L, rule = [], paint("═" * W, "head", color)
    L += [rule, paint(" Run list verification".ljust(W - 22) + f"ghworkflowhunt {__version__}", "head", color), rule]
    ok = sum(1 for r in results if r["status"] == "VERIFIED")
    L.append(f"  {'Checked (UTC)':<24}{datetime.strptime(stamp, '%Y%m%dT%H%M%SZ').strftime('%Y-%m-%d %H:%M:%S')}")
    L.append(f"  {'Evidence':<24}{out}")
    L.append(f"  {'Repos':<24}" + paint(f"{len(results)}  ({ok} verified, {len(results) - ok} need attention)",
                                         "ok" if ok == len(results) else "error", color))
    order = sorted(results, key=lambda r: (r["status"] == "VERIFIED", r["repo"]))
    style = {"VERIFIED": "ok", "DELETED?": "warn"}
    L += [""] + table(["Repo", "Status", "Collected", "GitHub", "Windows", "Run window (UTC)"],
                      [[r["repo"], (r["status"], style.get(r["status"], "error")), r.get("collected", "—"),
                        r.get("github", "—"), r.get("windows", "—"), r.get("window", r.get("detail", ""))]
                       for r in order], [30, 10, 9, 7, 7, 41], color)
    L.append(paint("  Run window = the original run's --since up to its --until, or up to the newest run it\n"
                   "  collected when no --until was given.", "dim", color))
    for r in order:
        if r["status"] in ("VERIFIED",) or "bad" not in r:
            continue
        L += ["", paint(f"── {r['repo']}", "head", color)]
        for w in r["bad"]:
            L.append(f"  {w['status']:<9} {_hms(w['window_start_utc'])} → {_hms(w['window_end_utc'])}   "
                     f"GitHub {w['github_total']}, collected {w['collected']}")
        if r["dupes"]:
            L.append(f"  {r['dupes']} duplicate run ID(s) in api_runs_all.json")
        if any(w["status"] == "SHORT" for w in r["bad"]):
            w = next(w for w in r["bad"] if w["status"] == "SHORT")
            L.append(paint(f"  Re-collect, e.g.: ghworkflowhunt {r['repo']} --since {w['window_start_utc']} "
                           f"--until {w['window_end_utc']} --out <new folder>\n"
                           "  (one per SHORT window), or re-run the whole repo into the same --out.", "dim", color))
    L += ["", paint("  VERIFIED = every window's count from GitHub equals the runs collected. SHORT = GitHub has\n"
                    "  more runs than were collected (re-collect). DELETED? = fewer on GitHub now than collected:\n"
                    "  runs were deleted after collection (worth noting; the collected copies are evidence).\n"
                    "  The run window comes from the original run's summary unless --since/--until are given.",
                    "dim", color), "", rule]
    return "\n".join(L) + "\n"


# --------------------------------------------------------------------------- manifest

def write_manifest(root: Path, skip_dir: Path):
    lines = []
    for p in sorted(root.rglob("*")):
        if p.is_file() and skip_dir not in p.parents and p.name != "manifest.sha256":
            h = hashlib.sha256(p.read_bytes()).hexdigest()
            lines.append(f"{h}  {p.relative_to(root)}")
    (root / "manifest.sha256").write_text("\n".join(lines) + "\n")


# --------------------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("repos", nargs="*",
                    help="owner/repo (several, a quoted space/comma-separated list, or GitHub URLs); "
                         "with --verify-only, defaults to every repo in --out")
    ap.add_argument("--verify-only", action="store_true",
                    help="don't collect anything: check that the run lists already in --out are complete "
                         "(one small API call per time window)")
    ap.add_argument("--since", default=None,
                    help="runs created on/after this UTC date or time (YYYY-MM-DD or 2026-10-23T14:00:00Z)")
    ap.add_argument("--until", help="runs created on/before this UTC date or time (a bare date includes that whole day)")
    ap.add_argument("--out", default="evidence")
    ap.add_argument("--pattern", action="append", default=[],
                    help="add a STRONG regex (flags on one hit); repeatable")
    ap.add_argument("--weak-pattern", action="append", default=[],
                    help="add a WEAK regex (flags only in combination); repeatable")
    ap.add_argument("--weak-threshold", type=int, default=WEAK_THRESHOLD, metavar="N",
                    help=f"distinct weak patterns needed to flag (default {WEAK_THRESHOLD}; 0 = never)")
    ap.add_argument("--only-patterns", action="store_true",
                    help="drop built-in patterns; use only --pattern / --weak-pattern")
    ap.add_argument("--no-api", action="store_true", help="git history only")
    ap.add_argument("--no-color", action="store_true", help="disable colored output")
    ap.add_argument("-v", "--version", action="version", version=f"%(prog)s {__version__}")
    ap.add_argument("--no-download", action="store_true", help="skip logs/artifact downloads")
    ap.add_argument("--audit-log", action="store_true",
                    help="also query the org audit log for artifact/log deletions "
                         "(needs an org owner token; set AUDIT_LOG_TOKEN at the top)")
    a = ap.parse_args()
    a.repos = normalize_repos(a.repos)
    if not a.repos and not a.verify_only:
        ap.error("give at least one owner/repo (or use --verify-only on an existing --out folder)")
    global USE_COLOR, USE_COLOR_OUT
    if a.no_color:
        USE_COLOR = USE_COLOR_OUT = False

    token = (GITHUB_TOKEN.strip() or os.environ.get("GITHUB_TOKEN")
             or os.environ.get("GH_TOKEN") or "").strip()
    if not a.no_api:
        if not token:
            die("No token found. Set GITHUB_TOKEN at the top of the script "
                     "(or in your environment), or run with --no-api for git history only.")
        validate_token(token)
    if a.verify_only:
        if a.no_api:
            die("--verify-only needs the API (drop --no-api)")
        verify_only(a, token)
    if not a.since:
        a.since = "2026-01-01"
    log(f"git access: {set_git_auth(token)}")
    if a.only_patterns:
        rules = Rules(a.pattern, a.weak_pattern, a.weak_threshold)
    else:
        rules = Rules(STRONG_PATTERNS + a.pattern, WEAK_PATTERNS + a.weak_pattern, a.weak_threshold)
    if not rules.strong and not (rules.weak and rules.threshold):
        die("No patterns can flag anything. Add --pattern, or --weak-pattern with a threshold above 0.")

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    out = Path(a.out)
    out.mkdir(parents=True, exist_ok=True)
    summary = {"collected_utc": stamp, "since": a.since, "until": a.until,
               "patterns": rules.describe(), "repos": {}}
    report_repos, failed = {}, {}
    log(f"{len(a.repos)} repo(s): {', '.join(a.repos)}")

    for repo in a.repos:
        log(f"== {repo}", "head")
        repo_dir = out / repo.replace("/", "__")
        repo_dir.mkdir(parents=True, exist_ok=True)
        mirror = repo_dir / "mirror.git"
        try:
            mirror_clone(repo, mirror)
        except RuntimeError as e:
            reason = clone_error(str(e))
            log(f"  SKIPPED: could not clone {repo}: {reason}", "error")
            failed[repo] = reason
            summary["repos"][repo] = {"error": reason}
            continue

        api_rows = []
        if not a.no_api:
            api_rows = hunt_api(repo, token, a.since, a.until, rules, repo_dir, mirror,
                                not a.no_download)
        git_rows = scan_git(mirror, rules, repo_dir / "git_workflow_commits.tsv")
        bad_refs = scan_refs(mirror, rules)
        (repo_dir / "suspicious_refs.txt").write_text("\n".join(bad_refs) + ("\n" if bad_refs else ""))

        # Bundle the mirror so the preserved repo is a single hashable file
        git(["bundle", "create", str(repo_dir / f"{repo.replace('/', '__')}_{stamp}.bundle"),
             "--all"], cwd=mirror, check=False)
        write_manifest(repo_dir, mirror)

        s = {
            "runs_total": len(api_rows),
            "runs_complete": ((repo_dir / "api_runs_completeness.txt").read_text()
                              if (repo_dir / "api_runs_completeness.txt").exists() else ""),
            "runs_flagged_strong": sum(1 for r in api_rows if r["flagged"] == "strong"),
            "runs_flagged_weak_combo": sum(1 for r in api_rows if r["flagged"] == "weak-combo"),
            "runs_yaml_missing": sum(1 for r in api_rows if r["yaml_retrieved"] == "no"),
            "workflow_commit_count": len({r["commit"] for r in git_rows}),
            "workflow_commits": len(git_rows),
            "workflow_commits_flagged_strong": sum(1 for r in git_rows if r["flagged"] == "strong"),
            "workflow_commits_flagged_weak_combo": sum(1 for r in git_rows if r["flagged"] == "weak-combo"),
            "suspicious_refs": bad_refs,
        }
        summary["repos"][repo] = s
        files = [f"{repo_dir}/{n}" for n in ("api_runs.tsv", "git_workflow_commits.tsv",
                                             "suspicious_refs.txt", "manifest.sha256")
                 if (repo_dir / n).exists()]
        if (repo_dir / "runs").exists():
            files.append(f"{repo_dir}/runs/  (per-run evidence)")
        audit = None
        if a.audit_log and not a.no_api:
            atok = AUDIT_LOG_TOKEN.strip() or token
            log("  querying org audit log for artifact.destroy / checks.delete_logs")
            ev, err = audit_log_events(repo.split("/")[0], repo, atok, a.since)
            if err:
                log(f"  audit log not available: {err}", "warn")
            else:
                (repo_dir / "audit_log_events.json").write_text(json.dumps(ev, indent=2))
                write_manifest(repo_dir, mirror)  # include the audit log file in the hashes
                log(f"  audit log: {len(ev)} deletion events", "flag" if ev else "ok")
            audit = (ev or [], err)
        report_repos[repo] = {"stats": s, "runs": api_rows, "commits": git_rows,
                              "refs": bad_refs, "files": files, "audit": audit}
        log(f"  done: {s['runs_flagged_strong']} strong / {s['runs_flagged_weak_combo']} weak-combo "
            f"flagged runs of {s['runs_total']}", "flag" if s["runs_flagged_strong"] else "ok")

    (out / f"summary_{stamp}.json").write_text(json.dumps(summary, indent=2))
    meta = {"collected": datetime.strptime(stamp, "%Y%m%dT%H%M%SZ").strftime("%Y-%m-%d %H:%M:%S"),
            "since": a.since, "until": a.until, "patterns": rules.describe(), "failed": failed}
    plain = render_report(meta, report_repos, color=False)
    for name in (f"summary_{stamp}.txt", "summary.txt"):
        (out / name).write_text(plain, encoding="utf-8")
    try:
        sys.stdout.write(render_report(meta, report_repos, color=USE_COLOR_OUT))
    except UnicodeEncodeError:  # legacy Windows console code pages
        sys.stdout.write(plain.encode("ascii", "replace").decode())
    log(f"Report saved to {out / 'summary.txt'} (and summary_{stamp}.txt); "
        f"machine-readable copy in summary_{stamp}.json", "ok")


if __name__ == "__main__":
    main()
